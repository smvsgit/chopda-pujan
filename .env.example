POSTGRES_DB=smvs_chopda
POSTGRES_USER=smvs
POSTGRES_PASSWORD=change-me
POSTGRES_PASSWORD_URLENC=change-me

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=Admin@123456

# Seeded on first boot only. Change them, then change again inside the app.
ADMIN_PASSWORD=Admin@123
SANT_PASSWORD=change-me-as-well

# 1 once served over HTTPS.
COOKIE_SECURE=0
WEB_CONCURRENCY=3

# ---- Email ----------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mk@smvs.org
SMTP_PASSWORD=mpvmcesjumommsup
SMTP_FROM=mk@smvs.org
SMTP_FROM_NAME=SMVS Chopda-Pujan
SMTP_TLS=1
SMTP_SSL=0

# ---- SMS & Whasapp ----------------------------------------------------
TEXTGURU_LOGINID=smvs.org
TEXTGURU_PASSWORD=tExtgUru@357
TEXTGURU_SENDERID=SMVWEB
TEXTGURU_URL=https://www.textguru.in/api/sendsms.php

WHATSAPP_API_KEY=6ab85722-8586-11f0-98fc-02c8a5e042bd
WHATSAPP_FROM_NUMBER=918670058009
WHATSAPP_BASE_URL=https://partnersv1.pinbot.ai/v3/723335100870260/messages
PUBLIC_BASE_URL=

# Prefixed to 10-digit mobile numbers when building wa.me links.
WHATSAPP_COUNTRY_CODE=91

ENABLE_SMS_NOTIFICATIONS=True
ENABLE_WHATSAPP_NOTIFICATIONS=True

# ---- Message on check-in -------------------------------------------------
# 1 sends the "Check-in confirmation" template the moment someone is checked
# in. Set to 0 to stop it without deleting the template. A failure here never
# blocks a check-in - the seat is issued either way.
CHECKIN_SMS=1

# ---- QR links in messages ------------------------------------------------
# {qr} in a template becomes a signed link to that pass's QR image. The link
# has to be openable without signing in, because a mail client fetches it, so
# it is signed and expires after this many days.
QR_LINK_DAYS=10

# ---- Sign-in lockout -----------------------------------------------------
LOGIN_MAX_TRIES=8
LOGIN_LOCK_MINUTES=15

# ---- Scheduled messages --------------------------------------------------
# 1 runs the scheduler inside the app. 0 if you would rather drive it from
# cron against POST /api/schedules/run-due.
SCHEDULER=1

SITE_URL="http://localhost:3000"

# Host Routing Control Mappings
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.dev,.ngrok.io,steamtight-babara-unrelatively.ngrok-free.dev
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.ngrok-free.dev,https://steamtight-babara-unrelatively.ngrok-free.dev

# ---- Running behind nginx on a path (smvs.org/chopdapujan) ---------------
# See DEPLOY.md. Leave both empty for a subdomain.
APP_ROOT=
BEHIND_PROXY=0
COOKIE_NAME=chopdapujan_session
MAX_UPLOAD_MB=12

# ---- Interface language --------------------------------------------------
# Which language a new account starts in. gu or en.
DEFAULT_LANGUAGE=en

# ---- Schema changes ------------------------------------------------------
# 1 keeps the hand-written idempotent ALTER statements running, which an
# un-stamped database still needs. Set to 0 after running
# `flask db stamp head` once - see MIGRATIONS.md.
LEGACY_ALTERS=0