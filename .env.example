# SMVS Coolify production example - PLACEHOLDERS ONLY.
# Enter secret values in Coolify's protected environment/secret store.

# DB01 PostgreSQL 16 -> 192.168.40.10:5432
# URL-encode special characters in the password when using DATABASE_URL.
DATABASE_URL=postgresql://chopdapujan_app:URL_ENCODED_PASSWORD@192.168.40.10:5432/chopdapujan_prod

# Generate locally, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_ADMIN_PASSWORD
SANT_PASSWORD=REPLACE_WITH_STRONG_INITIAL_SANT_PASSWORD

# For the FIRST deployment to a NEW EMPTY DB only. Change to none after PASS.
DB_SCHEMA_MODE=bootstrap
LEGACY_ALTERS=0

MEDIA_ROOT=/app/media
COOKIE_SECURE=1
BEHIND_PROXY=1
WEB_CONCURRENCY=3

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=SMVS Chopda-Pujan
SMTP_TLS=1

# SMS / TextGuru
TEXTGURU_LOGINID=
TEXTGURU_PASSWORD=
TEXTGURU_SENDERID=
TEXTGURU_ENTITYID=
TEXTGURU_TEMPLATEID=
TEXTGURU_URL=https://www.textguru.in/api/sendsms.php

# WhatsApp provider
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=
WHATSAPP_BASE_URL=
WHATSAPP_SEND_PATH=/messages
WHATSAPP_COUNTRY_CODE=91

# Set to the final HTTPS URL, e.g. https://chopdapujan.example.org
PUBLIC_BASE_URL=

CHECKIN_SMS=1
QR_LINK_DAYS=120
SELFSERVE_LINK_DAYS=180
SCHEDULER=1
LOGIN_MAX_TRIES=8
LOGIN_LOCK_MINUTES=15
MAX_UPLOAD_MB=12
APP_ROOT=
COOKIE_NAME=chopdapujan_session
DEFAULT_LANGUAGE=en
